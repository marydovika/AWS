				(size 1.27 1.27)
			)
		)
		(uuid "e1e57915-7ebf-47c9-ae7e-08af88f12788")
	)
	(text "5V2"
		(exclude_from_sim no)
		(at 427.228 128.778 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
		)
		(uuid "f27492e4-9007-4466-9661-261030968dbf")
	)
	(text_box "Schottky diodes have a much lower voltage drop (around 0.4V), as compared to the standard silicon diode which has a high forward \nvoltage drop of about 0.7V to 1.1V. When the solar setup is pushing 3 Amps through it, the diode will waste around 2 to 3 Watts of power as pure heat,\nmaking it run very hot and wasting valuable solar energy. which keeps the component cool and ensures more solar power actually reaches the battery. \nAllowing better solar charging efficiency."
		(exclude_from_sim no)
		(at 207.01 285.75 0)
		(size 92.71 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "0bda6cda-549d-4725-a66e-6f376bd85995")
	)
	(text_box "If the global GND is connected directly to the battery's raw negative terminal (B-), the BMS is physically bypassed. \nCurrent will flow backward through the OUT- to IN- path of the buck converter or via the copper ground plane, this\nrenders the BMS over-discharge protection completely useless."
		(exclude_from_sim no)
		(at 156.21 171.45 0)
		(size 58.42 21.59)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "235432ed-ed95-48f4-b5c2-1dd660e0d7ef")
	)
